rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 발표자료 PDF (사양서 §7) — 20MB 미만, PDF만
    match /pdfs/{team}/{file} {
      allow read: if true;
      allow write: if request.resource != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
  }
}
